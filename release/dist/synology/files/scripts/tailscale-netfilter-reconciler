#!/bin/bash

set -u

export PATH="/usr/syno/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

PKG_NAME="${SYNOPKG_PKGNAME:-Tailscale}"
PKG_ROOT="${TAILSCALE_SYNOLOGY_PACKAGE_ROOT:-/var/packages/${PKG_NAME}}"

PKGVAR="${TAILSCALE_RECONCILER_PKGVAR:-${SYNOPKG_PKGVAR:-${PKG_ROOT}/var}}"

TAILSCALE_BIN="${TAILSCALE_RECONCILER_TAILSCALE_BIN:-${SYNOPKG_PKGDEST:-${PKG_ROOT}/target}/bin/tailscale}"
SOCKET_FILE="${TAILSCALE_RECONCILER_SOCKET_FILE:-${PKGVAR}/tailscaled.sock}"

IPTABLES_BIN="${TAILSCALE_RECONCILER_IPTABLES_BIN:-}"
IP6TABLES_BIN="${TAILSCALE_RECONCILER_IP6TABLES_BIN:-}"

PID_FILE="${TAILSCALE_RECONCILER_PID_FILE:-${PKGVAR}/tailscale-netfilter-reconciler.pid}"
PENDING_FILE="${TAILSCALE_RECONCILER_PENDING_FILE:-${PKGVAR}/tailscale-netfilter-repair.pending}"

BOOT_PHASE_SECONDS="${TAILSCALE_SYNOLOGY_RECONCILER_BOOT_SECONDS:-120}"
BOOT_INTERVAL_SECONDS="${TAILSCALE_SYNOLOGY_RECONCILER_BOOT_INTERVAL:-2}"
STEADY_INTERVAL_SECONDS="${TAILSCALE_SYNOLOGY_RECONCILER_STEADY_INTERVAL:-30}"
REPAIR_COOLDOWN_SECONDS="${TAILSCALE_SYNOLOGY_RECONCILER_REPAIR_COOLDOWN:-5}"
VERIFY_SECONDS="${TAILSCALE_SYNOLOGY_RECONCILER_VERIFY_SECONDS:-2}"

TEST_MODE="${TAILSCALE_SYNOLOGY_TEST_MODE:-0}"
TEST_MAX_ITERATIONS="${TAILSCALE_SYNOLOGY_RECONCILER_TEST_MAX_ITERATIONS:-0}"
TEST_NO_SLEEP="${TAILSCALE_SYNOLOGY_RECONCILER_TEST_NO_SLEEP:-0}"

STOP_REQUESTED=0
SLEEP_PID=""
LAST_STATE=""
LAST_PHASE=""
LAST_REPAIR_EPOCH=0


log_message() {
    local level="$1"
    shift

    local timestamp
    timestamp="$(date --iso-8601=second)"

    printf '%s %s: %s\n' \
        "${timestamp}" \
        "${level}" \
        "$*"
}


require_positive_integer() {
    local name="$1"
    local value="$2"

    case "${value}" in
    ''|*[!0-9]*|0)
        log_message ERROR \
            "${name} must be a positive integer; received ${value}"
        return 1
        ;;
    esac

    return 0
}


require_nonnegative_integer() {
    local name="$1"
    local value="$2"

    case "${value}" in
    ''|*[!0-9]*)
        log_message ERROR \
            "${name} must be a non-negative integer; received ${value}"
        return 1
        ;;
    esac

    return 0
}


validate_configuration() {
    require_positive_integer \
        BOOT_PHASE_SECONDS \
        "${BOOT_PHASE_SECONDS}" ||
        return 1

    require_positive_integer \
        BOOT_INTERVAL_SECONDS \
        "${BOOT_INTERVAL_SECONDS}" ||
        return 1

    require_positive_integer \
        STEADY_INTERVAL_SECONDS \
        "${STEADY_INTERVAL_SECONDS}" ||
        return 1

    require_positive_integer \
        REPAIR_COOLDOWN_SECONDS \
        "${REPAIR_COOLDOWN_SECONDS}" ||
        return 1

    require_positive_integer \
        VERIFY_SECONDS \
        "${VERIFY_SECONDS}" ||
        return 1

    require_nonnegative_integer \
        TEST_MAX_ITERATIONS \
        "${TEST_MAX_ITERATIONS}" ||
        return 1

    [ -x "${TAILSCALE_BIN}" ] || {
        log_message ERROR \
            "tailscale CLI is unavailable: ${TAILSCALE_BIN}"
        return 1
    }

    return 0
}


handle_stop() {
    local sleep_pid="${SLEEP_PID}"

    STOP_REQUESTED=1

    if [ -n "${sleep_pid}" ]; then
        kill -TERM \
            "${sleep_pid}" \
            >/dev/null 2>&1 ||
            true
    fi
}


cleanup_pid_file() {
    local stored_pid=""

    if [ -r "${PID_FILE}" ]; then
        IFS= read -r stored_pid <"${PID_FILE}" ||
            stored_pid=""

        if [ "${stored_pid}" = "$$" ]; then
            rm -f -- "${PID_FILE}"
        fi
    fi
}


sleep_for() {
    local duration="$1"
    local sleep_pid
    local wait_status=0

    if [ "${TEST_MODE}" = "1" ] &&
        [ "${TEST_NO_SLEEP}" = "1" ]
    then
        return 0
    fi

    if [ "${STOP_REQUESTED}" -ne 0 ]; then
        return 0
    fi

    sleep "${duration}" &

    sleep_pid=$!
    SLEEP_PID="${sleep_pid}"

    if [ "${STOP_REQUESTED}" -ne 0 ]; then
        kill -TERM \
            "${sleep_pid}" \
            >/dev/null 2>&1 ||
            true
    fi

    wait "${sleep_pid}" ||
        wait_status=$?

    SLEEP_PID=""

    if [ "${STOP_REQUESTED}" -ne 0 ]; then
        return 0
    fi

    return "${wait_status}"
}


tailscale_cli() {
    "${TAILSCALE_BIN}" \
        --socket="${SOCKET_FILE}" \
        "$@"
}


prefs_require_netfilter() {
    local output

    output="$(
        tailscale_cli \
            debug prefs \
            2>/dev/null
    )" || return 1

    grep -Eq \
        '"WantRunning"[[:space:]]*:[[:space:]]*true' \
        <<<"${output}" ||
        return 1

    grep -Eq \
        '"NetfilterMode"[[:space:]]*:[[:space:]]*2' \
        <<<"${output}" ||
        return 1

    return 0
}


backend_running() {
    local output

    output="$(
        tailscale_cli \
            status \
            --json \
            2>/dev/null
    )" || return 1

    grep -Eq \
        '"BackendState"[[:space:]]*:[[:space:]]*"Running"' \
        <<<"${output}"
}


netfilter_hooks_complete() {
    local iptables_bin="${IPTABLES_BIN}"
    local ip6tables_bin="${IP6TABLES_BIN}"

    if [ -z "${iptables_bin}" ]; then
        iptables_bin="$(
            command -v iptables 2>/dev/null
        )" || return 1
    fi

    "${iptables_bin}" \
        -t filter \
        -C INPUT \
        -j ts-input \
        >/dev/null 2>&1 ||
        return 1

    "${iptables_bin}" \
        -t filter \
        -C FORWARD \
        -j ts-forward \
        >/dev/null 2>&1 ||
        return 1

    "${iptables_bin}" \
        -t nat \
        -C POSTROUTING \
        -j ts-postrouting \
        >/dev/null 2>&1 ||
        return 1

    if [ -z "${ip6tables_bin}" ]; then
        ip6tables_bin="$(
            command -v ip6tables 2>/dev/null
        )" || ip6tables_bin=""
    fi

    if [ -n "${ip6tables_bin}" ] &&
        "${ip6tables_bin}" \
            -t filter \
            -S \
            >/dev/null 2>&1
    then
        "${ip6tables_bin}" \
            -t filter \
            -C INPUT \
            -j ts-input \
            >/dev/null 2>&1 ||
            return 1

        "${ip6tables_bin}" \
            -t filter \
            -C FORWARD \
            -j ts-forward \
            >/dev/null 2>&1 ||
            return 1
    fi

    return 0
}


mark_repair_pending() {
    local temporary="${PENDING_FILE}.tmp.$$"

    umask 077

    printf '%s\n' \
        "$$" \
        >"${temporary}" ||
        return 1

    mv -f -- \
        "${temporary}" \
        "${PENDING_FILE}"
}


clear_repair_pending() {
    rm -f -- "${PENDING_FILE}"
}


restore_pending_repair() {
    local output
    local status

    if ! backend_running; then
        return 1
    fi

    log_message NOTICE \
        "an interrupted netfilter repair is pending; restoring netfilter mode on"

    output="$(
        tailscale_cli \
            set \
            --netfilter-mode=on \
            2>&1
    )"

    status=$?

    if [ "${status}" -ne 0 ]; then
        log_message ERROR \
            "cannot restore netfilter mode on: ${output}"
        return 1
    fi

    clear_repair_pending

    sleep_for "${VERIFY_SECONDS}"

    if netfilter_hooks_complete; then
        log_message INFO \
            "interrupted netfilter repair was recovered successfully"
        return 0
    fi

    log_message WARNING \
        "netfilter mode was restored, but required hooks remain incomplete"

    return 1
}


repair_netfilter() {
    local output
    local off_status
    local on_status

    if ! mark_repair_pending; then
        log_message ERROR \
            "cannot create repair marker ${PENDING_FILE}"
        return 1
    fi

    log_message NOTICE \
        "rebuilding incomplete Tailscale netfilter state"

    output="$(
        tailscale_cli \
            set \
            --netfilter-mode=off \
            2>&1
    )"

    off_status=$?

    if [ "${off_status}" -ne 0 ]; then
        log_message WARNING \
            "netfilter disable failed; still attempting to restore mode on: ${output}"
    else
        sleep_for 1
    fi

    output="$(
        tailscale_cli \
            set \
            --netfilter-mode=on \
            2>&1
    )"

    on_status=$?

    if [ "${on_status}" -ne 0 ]; then
        log_message ERROR \
            "netfilter enable failed; repair marker retained for recovery: ${output}"
        return 1
    fi

    clear_repair_pending

    sleep_for "${VERIFY_SECONDS}"

    if netfilter_hooks_complete; then
        log_message INFO \
            "Tailscale netfilter repair completed successfully"
        return 0
    fi

    log_message WARNING \
        "Tailscale netfilter hooks remain incomplete after reconstruction"

    return 1
}


set_state() {
    local new_state="$1"
    local level="$2"
    shift 2

    if [ "${LAST_STATE}" != "${new_state}" ]; then
        log_message "${level}" "$@"
        LAST_STATE="${new_state}"
    fi
}


reconcile_once() {
    local now
    local since_last_repair

    if [ -e "${PENDING_FILE}" ]; then
        if restore_pending_repair; then
            LAST_STATE="healthy"
        else
            LAST_STATE="repair-pending"
        fi

        return
    fi

    # Keep healthy operation cheap. Only consult LocalAPI when one or
    # more required firewall hooks are actually missing.
    if netfilter_hooks_complete; then
        if [ "${LAST_STATE}" = "missing" ] ||
            [ "${LAST_STATE}" = "repair-failed" ]
        then
            log_message INFO \
                "Tailscale netfilter hooks are complete again"
        fi

        LAST_STATE="healthy"

        return
    fi

    if ! backend_running; then
        set_state \
            waiting \
            INFO \
            "waiting for the Tailscale backend to reach Running state"

        return
    fi

    if ! prefs_require_netfilter; then
        set_state \
            inactive \
            INFO \
            "current Tailscale preferences do not require netfilter reconciliation"

        return
    fi

    set_state \
        missing \
        NOTICE \
        "Tailscale netfilter hooks are incomplete"

    now="$(date +%s)"
    since_last_repair=$((now - LAST_REPAIR_EPOCH))

    if [ "${LAST_REPAIR_EPOCH}" -ne 0 ] &&
        [ "${since_last_repair}" -lt "${REPAIR_COOLDOWN_SECONDS}" ]
    then
        return
    fi

    LAST_REPAIR_EPOCH="${now}"

    if repair_netfilter; then
        LAST_STATE="healthy"
    else
        LAST_STATE="repair-failed"
    fi
}


main() {
    local start_epoch
    local now
    local elapsed
    local phase
    local interval
    local iterations=0

    validate_configuration ||
        return 1

    trap handle_stop TERM INT HUP
    trap cleanup_pid_file EXIT

    start_epoch="$(date +%s)"

    log_message INFO \
        "started: boot phase ${BOOT_PHASE_SECONDS}s/${BOOT_INTERVAL_SECONDS}s, steady state ${STEADY_INTERVAL_SECONDS}s"

    while [ "${STOP_REQUESTED}" -eq 0 ]; do
        now="$(date +%s)"
        elapsed=$((now - start_epoch))

        if [ "${elapsed}" -lt "${BOOT_PHASE_SECONDS}" ]; then
            phase="boot"
            interval="${BOOT_INTERVAL_SECONDS}"
        else
            phase="steady"
            interval="${STEADY_INTERVAL_SECONDS}"
        fi

        if [ "${phase}" != "${LAST_PHASE}" ]; then
            log_message INFO \
                "entered ${phase} reconciliation phase"
            LAST_PHASE="${phase}"
        fi

        reconcile_once

        iterations=$((iterations + 1))

        if [ "${TEST_MODE}" = "1" ] &&
            [ "${TEST_MAX_ITERATIONS}" -gt 0 ] &&
            [ "${iterations}" -ge "${TEST_MAX_ITERATIONS}" ]
        then
            break
        fi

        sleep_for "${interval}"
    done

    log_message INFO \
        "stopped"

    return 0
}


main "$@"
