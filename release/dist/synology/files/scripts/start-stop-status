#!/bin/bash

SERVICE_NAME="tailscale"

# DSM package services receive a restricted environment. Include the standard
# system paths required for ip, iptables, ip6tables, nft, and related tools.
export PATH="${SYNOPKG_PKGDEST}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Route subnet traffic through the Linux kernel rather than netstack.
export TS_DEBUG_NETSTACK_SUBNETS=false

# DSM 7.3 on this package is validated against the legacy iptables backend.
# Keep backend selection deterministic so the startup reconciler and the
# Synology-specific daemon self-healing path operate on the same firewall.
export TS_DEBUG_FIREWALL_MODE=iptables

if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -eq "6" ]; then
    PKGVAR="/var/packages/Tailscale/etc"
else
    PKGVAR="${SYNOPKG_PKGVAR}"
fi

PKG_NAME="${SYNOPKG_PKGNAME:-Tailscale}"
PKG_ROOT="${TAILSCALE_SYNOLOGY_PACKAGE_ROOT:-/var/packages/${PKG_NAME}}"

BOOTSTRAP_STATE_FILE="${PKGVAR}/root-bootstrap.state"
ACTIVE_PRIVILEGE_FILE="${PKG_ROOT}/conf/privilege"
ROOT_PRIVILEGE_TEMPLATE="${PKG_ROOT}/conf/privilege.bootstrap-root"
BOOTSTRAP_COMMAND="sudo ${PKG_ROOT}/scripts/tailscale-synology-bootstrap install"

PID_FILE="${PKGVAR}/tailscaled.pid"
LOG_FILE="${PKGVAR}/tailscaled.stdout.log"
STATE_FILE="${PKGVAR}/tailscaled.state"
SOCKET_FILE="${PKGVAR}/tailscaled.sock"
PORT="41641"

TAILSCALE_BIN="${SYNOPKG_PKGDEST}/bin/tailscale"

NETFILTER_LOCALAPI_ATTEMPTS="${TAILSCALE_SYNOLOGY_LOCALAPI_ATTEMPTS:-30}"

TUN_DEVICE="${TAILSCALE_SYNOLOGY_TUN_DEVICE:-/dev/net/tun}"
TUN_PROC_MISC="${TAILSCALE_SYNOLOGY_TUN_PROC_MISC:-/proc/misc}"
TUN_WAIT_ATTEMPTS="${TAILSCALE_SYNOLOGY_TUN_WAIT_ATTEMPTS:-10}"
TUN_WAIT_SECONDS="${TAILSCALE_SYNOLOGY_TUN_WAIT_SECONDS:-1}"

RECONCILER_SCRIPT="${PKG_ROOT}/scripts/tailscale-netfilter-reconciler"
RECONCILER_PID_FILE="${PKGVAR}/tailscale-netfilter-reconciler.pid"
RECONCILER_LOG_FILE="${PKGVAR}/tailscale-netfilter-reconciler.log"
RECONCILER_PENDING_FILE="${PKGVAR}/tailscale-netfilter-repair.pending"

RECONCILER_START_ATTEMPTS="${TAILSCALE_SYNOLOGY_RECONCILER_START_ATTEMPTS:-10}"

SERVICE_COMMAND="${SYNOPKG_PKGDEST}/bin/tailscaled \
--state=${STATE_FILE} \
--socket=${SOCKET_FILE} \
--port=${PORT} \
--tun=tailscale0"

if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -eq "6" ]; then
    chown -R tailscale:tailscale "${PKGVAR}/"
fi

start_daemon() {
    local ts=$(date --iso-8601=second)
    echo "${ts} Starting ${SERVICE_NAME} with: ${SERVICE_COMMAND}" >${LOG_FILE}
    STATE_DIRECTORY=${PKGVAR} ${SERVICE_COMMAND} 2>&1 | sed -u '1,200p;201s,.*,[further tailscaled logs suppressed],p;d' >>${LOG_FILE} &
    # We pipe tailscaled's output to sed, so "$!" retrieves the PID of sed not tailscaled.
    # Use jobs -p to retrieve the PID of the most recent process group leader.
    jobs -p >"${PID_FILE}"
}

stop_daemon() {
    if [ -r "${PID_FILE}" ]; then
        local PID=$(cat "${PID_FILE}")
        local ts=$(date --iso-8601=second)
        echo "${ts} Stopping ${SERVICE_NAME} service PID=${PID}" >>${LOG_FILE}
        kill -TERM $PID >>${LOG_FILE} 2>&1
        wait_for_status 1 || kill -KILL $PID >>${LOG_FILE} 2>&1
        rm -f "${PID_FILE}" >/dev/null
    fi
}

daemon_status() {
    if [ -r "${PID_FILE}" ]; then
        local PID=$(cat "${PID_FILE}")
        if ps -o pid -p ${PID} > /dev/null; then
            return
        fi
        rm -f "${PID_FILE}" >/dev/null
    fi
    return 1
}

wait_for_status() {
    # 20 tries
    # sleeps for 1 second after each try
    local counter=20
    while [ ${counter} -gt 0 ]; do
        daemon_status
        [ $? -eq $1 ] && return
        counter=$((counter - 1))
        sleep 1
    done
    return 1
}

log_message() {
    local level="$1"
    shift

    local ts
    ts=$(date --iso-8601=second)

    echo "${ts} ${level}: $*" >&2
    echo "${ts} ${level}: $*" >>"${LOG_FILE}"
}

sha256_file() {
    local file="$1"

    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "${file}" | awk '{print $1}'
        return
    fi

    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "${file}" | awk '{print $1}'
        return
    fi

    if command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "${file}" | awk '{print $NF}'
        return
    fi

    return 127
}

bootstrap_state_value() {
    local key="$1"

    awk -F= -v key="${key}" '
        $1 == key {
            sub(/^[^=]*=/, "")
            print
            exit
        }
    ' "${BOOTSTRAP_STATE_FILE}"
}

secure_root_path() {
    local path="$1"
    local uid
    local mode
    local mode_value

    [ -e "${path}" ] || return 1

    uid="$(stat -c %u -- "${path}")" ||
        return 1

    [ "${uid}" = "0" ] ||
        return 1

    mode="$(stat -c %a -- "${path}")" ||
        return 1

    mode_value=$((8#${mode}))

    if (( mode_value & 8#022 )); then
        return 1
    fi

    return 0
}

bootstrap_is_current() {
    local stored_binary_hash
    local stored_privilege_hash
    local current_binary_hash
    local current_privilege_hash
    local target_real

    if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -ne "7" ]; then
        return 0
    fi

    [ -r "${BOOTSTRAP_STATE_FILE}" ] || return 1
    [ -r "${ACTIVE_PRIVILEGE_FILE}" ] || return 1
    [ -r "${ROOT_PRIVILEGE_TEMPLATE}" ] || return 1
    [ -x "${SYNOPKG_PKGDEST}/bin/tailscaled" ] || return 1

    target_real="$(
        readlink -f -- "${SYNOPKG_PKGDEST}"
    )" || return 1

    secure_root_path "${target_real}" ||
        return 1

    secure_root_path "${SYNOPKG_PKGDEST}/bin/tailscaled" ||
        return 1

    secure_root_path "${ACTIVE_PRIVILEGE_FILE}" ||
        return 1

    secure_root_path "${ROOT_PRIVILEGE_TEMPLATE}" ||
        return 1

    secure_root_path "${BOOTSTRAP_STATE_FILE}" ||
        return 1

    [ "$(bootstrap_state_value schema)" = "1" ] || return 1
    [ "$(bootstrap_state_value mode)" = "root" ] || return 1

    stored_binary_hash="$(
        bootstrap_state_value tailscaled_sha256
    )"

    stored_privilege_hash="$(
        bootstrap_state_value privilege_sha256
    )"

    [ -n "${stored_binary_hash}" ] || return 1
    [ -n "${stored_privilege_hash}" ] || return 1

    current_binary_hash="$(
        sha256_file "${SYNOPKG_PKGDEST}/bin/tailscaled"
    )" || return 1

    current_privilege_hash="$(
        sha256_file "${ROOT_PRIVILEGE_TEMPLATE}"
    )" || return 1

    [ "${stored_binary_hash}" = "${current_binary_hash}" ] ||
        return 1

    [ "${stored_privilege_hash}" = "${current_privilege_hash}" ] ||
        return 1

    cmp -s \
        "${ACTIVE_PRIVILEGE_FILE}" \
        "${ROOT_PRIVILEGE_TEMPLATE}" ||
        return 1

    return 0
}

log_bootstrap_required() {
    log_message NOTICE \
        "Tailscale is installed but requires administrator bootstrap."

    log_message NOTICE \
        "Run: ${BOOTSTRAP_COMMAND}"
}


check_iptables_chain() {
    local table="$1"
    local chain="$2"
    local output
    local status

    output="$(
        "${IPTABLES_BIN}" \
            -t "${table}" \
            -S \
            2>&1
    )"
    status=$?

    if [ "${status}" -ne 0 ]; then
        log_message ERROR \
            "cannot access iptables ${table} table: ${output}"
        return 1
    fi

    if ! printf '%s\n' "${output}" |
        awk -v wanted="${chain}" '
            ($1 == "-P" || $1 == "-N") &&
            $2 == wanted {
                found = 1
                exit
            }

            END {
                exit found ? 0 : 1
            }
        '
    then
        log_message ERROR \
            "required iptables chain ${table}/${chain} is unavailable"
        return 1
    fi

    return 0
}


cleanup_iptables_rule_preflight() {
    local table="$1"
    local chain="$2"
    local failed=0

    "${IPTABLES_BIN}" \
        -t "${table}" \
        -F "${chain}" \
        >/dev/null 2>&1 ||
        failed=1

    "${IPTABLES_BIN}" \
        -t "${table}" \
        -X "${chain}" \
        >/dev/null 2>&1 ||
        failed=1

    return "${failed}"
}


check_iptables_rule_support() {
    local description="$1"
    local table="$2"
    local intended_chain="$3"
    local chain="ts-pf-rule-$$"
    local output
    local status

    shift 3

    output="$(
        "${IPTABLES_BIN}" \
            -t "${table}" \
            -N "${chain}" \
            2>&1
    )"
    status=$?

    if [ "${status}" -ne 0 ]; then
        log_message ERROR \
            "cannot create temporary ${table} preflight chain for ${description}: ${output}"
        return 1
    fi

    output="$(
        "${IPTABLES_BIN}" \
            -t "${table}" \
            -A "${chain}" \
            "$@" \
            2>&1
    )"
    status=$?

    if [ "${status}" -ne 0 ]; then
        cleanup_iptables_rule_preflight \
            "${table}" \
            "${chain}" ||
            true

        log_message ERROR \
            "iptables prerequisite ${description} for ${table}/${intended_chain} failed: ${output}"
        return 1
    fi

    output="$(
        "${IPTABLES_BIN}" \
            -t "${table}" \
            -C "${chain}" \
            "$@" \
            2>&1
    )"
    status=$?

    if [ "${status}" -ne 0 ]; then
        cleanup_iptables_rule_preflight \
            "${table}" \
            "${chain}" ||
            true

        log_message ERROR \
            "cannot verify iptables prerequisite ${description}: ${output}"
        return 1
    fi

    if ! cleanup_iptables_rule_preflight \
        "${table}" \
        "${chain}"
    then
        log_message ERROR \
            "cannot remove temporary ${table} preflight chain for ${description}"
        return 1
    fi

    return 0
}


cleanup_tailscale_nat_preflight() {
    local chain="$1"
    local failed=0

    while "${IPTABLES_BIN}" \
        -t nat \
        -D POSTROUTING \
        -j "${chain}" \
        >/dev/null 2>&1
    do
        :
    done

    # DSM exposes its effective built-in NAT chain as
    # DEFAULT_POSTROUTING in full table listings. This fallback is
    # harmless when the normal POSTROUTING deletion already succeeded.
    while "${IPTABLES_BIN}" \
        -t nat \
        -D DEFAULT_POSTROUTING \
        -j "${chain}" \
        >/dev/null 2>&1
    do
        :
    done

    "${IPTABLES_BIN}" \
        -t nat \
        -F "${chain}" \
        >/dev/null 2>&1 ||
        failed=1

    "${IPTABLES_BIN}" \
        -t nat \
        -X "${chain}" \
        >/dev/null 2>&1 ||
        failed=1

    return "${failed}"
}


check_tailscale_nat_topology() {
    local chain="ts-pf-nat-$$"
    local output
    local status

    output="$(
        "${IPTABLES_BIN}" \
            -t nat \
            -N "${chain}" \
            2>&1
    )"
    status=$?

    if [ "${status}" -ne 0 ]; then
        log_message ERROR \
            "cannot create temporary NAT preflight chain: ${output}"
        return 1
    fi

    output="$(
        "${IPTABLES_BIN}" \
            -t nat \
            -I POSTROUTING \
            1 \
            -j "${chain}" \
            2>&1
    )"
    status=$?

    if [ "${status}" -ne 0 ]; then
        cleanup_tailscale_nat_preflight "${chain}" ||
            true

        log_message ERROR \
            "cannot hook a temporary chain from nat/POSTROUTING: ${output}"
        return 1
    fi

    output="$(
        "${IPTABLES_BIN}" \
            -t nat \
            -C POSTROUTING \
            -j "${chain}" \
            2>&1
    )"
    status=$?

    if [ "${status}" -ne 0 ]; then
        cleanup_tailscale_nat_preflight "${chain}" ||
            true

        log_message ERROR \
            "cannot verify the temporary nat/POSTROUTING hook: ${output}"
        return 1
    fi

    output="$(
        "${IPTABLES_BIN}" \
            -t nat \
            -A "${chain}" \
            -m mark \
            --mark 0xfe0000/0xff0000 \
            -j MASQUERADE \
            2>&1
    )"
    status=$?

    if [ "${status}" -ne 0 ]; then
        cleanup_tailscale_nat_preflight "${chain}" ||
            true

        log_message ERROR \
            "cannot add a marked MASQUERADE rule: ${output}"
        return 1
    fi

    output="$(
        "${IPTABLES_BIN}" \
            -t nat \
            -C "${chain}" \
            -m mark \
            --mark 0xfe0000/0xff0000 \
            -j MASQUERADE \
            2>&1
    )"
    status=$?

    if [ "${status}" -ne 0 ]; then
        cleanup_tailscale_nat_preflight "${chain}" ||
            true

        log_message ERROR \
            "cannot verify the marked MASQUERADE rule: ${output}"
        return 1
    fi

    if ! cleanup_tailscale_nat_preflight "${chain}"; then
        log_message ERROR \
            "cannot remove the temporary NAT preflight topology"
        return 1
    fi

    return 0
}

check_netfilter_prerequisites() {
    if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -ne "7" ]; then
        return 0
    fi

    IPTABLES_BIN="$(command -v iptables 2>/dev/null)" || {
        log_message ERROR \
            "iptables was not found in PATH"
        return 1
    }

    check_iptables_chain filter INPUT ||
        return 1

    check_iptables_chain filter FORWARD ||
        return 1

    check_iptables_chain nat POSTROUTING ||
        return 1

    check_iptables_chain mangle PREROUTING ||
        return 1

    check_iptables_chain mangle OUTPUT ||
        return 1

    check_iptables_chain mangle FORWARD ||
        return 1

    check_iptables_rule_support \
        "MARK target" \
        filter \
        FORWARD \
        -j MARK --set-mark 0x40000/0xff0000 ||
        return 1

    check_iptables_rule_support \
        "mark match" \
        filter \
        FORWARD \
        -m mark --mark 0x40000/0xff0000 \
        -j ACCEPT ||
        return 1

    check_iptables_rule_support \
        "conntrack match" \
        filter \
        FORWARD \
        -m conntrack \
        ! --ctstate ESTABLISHED,RELATED \
        -j DROP ||
        return 1

    check_iptables_rule_support \
        "CONNMARK restore target" \
        mangle \
        PREROUTING \
        -m conntrack \
        --ctstate ESTABLISHED,RELATED \
        -j CONNMARK \
        --restore-mark \
        --nfmask 0xff0000 \
        --ctmask 0xff0000 ||
        return 1

    check_iptables_rule_support \
        "CONNMARK save target" \
        mangle \
        OUTPUT \
        -m conntrack \
        --ctstate NEW \
        -m mark \
        ! --mark 0x0/0xff0000 \
        -j CONNMARK \
        --save-mark \
        --nfmask 0xff0000 \
        --ctmask 0xff0000 ||
        return 1

    check_tailscale_nat_topology ||
        return 1

    check_iptables_rule_support \
        "TCPMSS target" \
        mangle \
        FORWARD \
        -p tcp \
        --tcp-flags SYN,RST SYN \
        -j TCPMSS \
        --clamp-mss-to-pmtu ||
        return 1

    return 0
}

tun_device_is_ready() {
    [ -c "${TUN_DEVICE}" ]
}


tun_driver_available() {
    [ -r "${TUN_PROC_MISC}" ] ||
        return 1

    awk '
        $1 == "200" && $2 == "tun" {
            found = 1
        }

        END {
            exit found ? 0 : 1
        }
    ' "${TUN_PROC_MISC}"
}


try_load_tun_driver() {
    local modprobe_bin

    modprobe_bin="$(
        command -v modprobe 2>/dev/null
    )" || return 1

    "${modprobe_bin}" \
        tun \
        >/dev/null 2>&1
}


ensure_tun_created() {
    local attempt=1
    local tun_directory="${TUN_DEVICE%/*}"

    case "${TUN_WAIT_ATTEMPTS}" in
    ''|*[!0-9]*|0)
        log_message ERROR \
            "TAILSCALE_SYNOLOGY_TUN_WAIT_ATTEMPTS must be a positive integer"
        return 1
        ;;
    esac

    case "${TUN_WAIT_SECONDS}" in
    ''|*[!0-9]*)
        log_message ERROR \
            "TAILSCALE_SYNOLOGY_TUN_WAIT_SECONDS must be a non-negative integer"
        return 1
        ;;
    esac

    while [ "${attempt}" -le "${TUN_WAIT_ATTEMPTS}" ]; do
        if tun_device_is_ready; then
            if ! chmod 0666 "${TUN_DEVICE}"; then
                log_message ERROR \
                    "cannot set permissions on ${TUN_DEVICE}"
                return 1
            fi

            return 0
        fi

        if ! tun_driver_available; then
            try_load_tun_driver ||
                true
        fi

        if tun_driver_available; then
            if ! mkdir -p -- "${tun_directory}"; then
                log_message ERROR \
                    "cannot create TUN device directory ${tun_directory}"
                return 1
            fi

            if ! chmod 0755 "${tun_directory}"; then
                log_message ERROR \
                    "cannot set permissions on ${tun_directory}"
                return 1
            fi

            if [ -e "${TUN_DEVICE}" ] ||
                [ -L "${TUN_DEVICE}" ]
            then
                if ! rm -f -- "${TUN_DEVICE}"; then
                    log_message ERROR \
                        "cannot replace invalid TUN device path ${TUN_DEVICE}"
                    return 1
                fi
            fi

            mknod \
                "${TUN_DEVICE}" \
                c \
                10 \
                200 \
                >/dev/null 2>&1 ||
                true

            if tun_device_is_ready; then
                if ! chmod 0666 "${TUN_DEVICE}"; then
                    log_message ERROR \
                        "cannot set permissions on ${TUN_DEVICE}"
                    return 1
                fi

                log_message INFO \
                    "created kernel TUN device ${TUN_DEVICE}"

                return 0
            fi
        fi

        if [ "${attempt}" -lt "${TUN_WAIT_ATTEMPTS}" ]; then
            sleep "${TUN_WAIT_SECONDS}"
        fi

        attempt=$((attempt + 1))
    done

    if tun_driver_available; then
        log_message ERROR \
            "kernel TUN driver is registered, but ${TUN_DEVICE} could not be created"
    else
        log_message ERROR \
            "kernel TUN driver is unavailable after ${TUN_WAIT_ATTEMPTS} attempts"
    fi

    return 1
}

set_sysctl_value() {
    local key="$1"
    local value="$2"
    local output
    local status

    output="$(
        sysctl \
            -w \
            "${key}=${value}" \
            2>&1
    )"

    status=$?

    if [ "${status}" -ne 0 ]; then
        log_message ERROR \
            "cannot set ${key}=${value}: ${output}"
        return 1
    fi

    log_message INFO \
        "applied ${output}"

    return 0
}


apply_routing_sysctls() {
    set_sysctl_value \
        net.ipv4.ip_forward \
        1 ||
        return 1

    if [ -e /proc/sys/net/ipv6/conf/all/forwarding ]; then
        set_sysctl_value \
            net.ipv6.conf.all.forwarding \
            1 ||
            return 1
    fi

    if [ -e /proc/sys/net/ipv4/conf/all/src_valid_mark ]; then
        set_sysctl_value \
            net.ipv4.conf.all.src_valid_mark \
            1 ||
            return 1
    fi

    return 0
}


wait_for_localapi() {
    local counter="${NETFILTER_LOCALAPI_ATTEMPTS}"

    while [ "${counter}" -gt 0 ]; do
        if "${TAILSCALE_BIN}" \
            --socket="${SOCKET_FILE}" \
            debug prefs \
            >/dev/null 2>&1
        then
            return 0
        fi

        if ! daemon_status; then
            log_message ERROR \
                "tailscaled exited while waiting for LocalAPI"
            return 1
        fi

        counter=$((counter - 1))
        sleep 1
    done

    log_message ERROR \
        "Tailscale LocalAPI did not become ready after ${NETFILTER_LOCALAPI_ATTEMPTS} seconds"

    return 1
}


reconciler_status() {
    local pid=""

    if [ ! -r "${RECONCILER_PID_FILE}" ]; then
        return 1
    fi

    IFS= read -r pid <"${RECONCILER_PID_FILE}" ||
        pid=""

    case "${pid}" in
    ''|*[!0-9]*)
        rm -f -- "${RECONCILER_PID_FILE}"
        return 1
        ;;
    esac

    if kill -0 "${pid}" >/dev/null 2>&1; then
        return 0
    fi

    rm -f -- "${RECONCILER_PID_FILE}"

    return 1
}


start_reconciler() {
    local pid
    local counter="${RECONCILER_START_ATTEMPTS}"

    if reconciler_status; then
        return 0
    fi

    [ -x "${RECONCILER_SCRIPT}" ] || {
        log_message ERROR \
            "netfilter reconciler is unavailable: ${RECONCILER_SCRIPT}"
        return 1
    }

    secure_root_path "${RECONCILER_SCRIPT}" || {
        log_message ERROR \
            "netfilter reconciler ownership or mode is unsafe: ${RECONCILER_SCRIPT}"
        return 1
    }

    rm -f -- "${RECONCILER_PID_FILE}"

    touch "${RECONCILER_LOG_FILE}" ||
        return 1

    chmod 0600 "${RECONCILER_LOG_FILE}" ||
        return 1

    TAILSCALE_RECONCILER_PKGVAR="${PKGVAR}" \
    TAILSCALE_RECONCILER_TAILSCALE_BIN="${TAILSCALE_BIN}" \
    TAILSCALE_RECONCILER_SOCKET_FILE="${SOCKET_FILE}" \
    TAILSCALE_RECONCILER_PID_FILE="${RECONCILER_PID_FILE}" \
    TAILSCALE_RECONCILER_PENDING_FILE="${RECONCILER_PENDING_FILE}" \
        "${RECONCILER_SCRIPT}" \
        >>"${RECONCILER_LOG_FILE}" \
        2>&1 &

    pid=$!

    printf '%s\n' \
        "${pid}" \
        >"${RECONCILER_PID_FILE}" ||
        return 1

    chmod 0600 "${RECONCILER_PID_FILE}" ||
        return 1

    while [ "${counter}" -gt 0 ]; do
        if reconciler_status; then
            log_message INFO \
                "started netfilter reconciler PID=${pid}"
            return 0
        fi

        counter=$((counter - 1))
        sleep 1
    done

    log_message ERROR \
        "netfilter reconciler did not remain running"

    rm -f -- "${RECONCILER_PID_FILE}"

    return 1
}


stop_reconciler() {
    local pid=""
    local counter=20

    if ! reconciler_status; then
        rm -f -- "${RECONCILER_PID_FILE}"
        return 0
    fi

    IFS= read -r pid <"${RECONCILER_PID_FILE}" ||
        pid=""

    log_message INFO \
        "stopping netfilter reconciler PID=${pid}"

    kill -TERM "${pid}" >/dev/null 2>&1 ||
        true

    while [ "${counter}" -gt 0 ]; do
        if ! kill -0 "${pid}" >/dev/null 2>&1; then
            rm -f -- "${RECONCILER_PID_FILE}"
            return 0
        fi

        counter=$((counter - 1))
        sleep 1
    done

    log_message WARNING \
        "netfilter reconciler did not stop after SIGTERM; sending SIGKILL"

    kill -KILL "${pid}" >/dev/null 2>&1 ||
        true

    rm -f -- "${RECONCILER_PID_FILE}"

    return 0
}


case $1 in
start)
    if daemon_status; then
        exit 0
    else
        if ! bootstrap_is_current; then
            log_bootstrap_required
            exit 0
        fi

        if [ "$(id -u 2>/dev/null)" != "0" ]; then
            log_message ERROR \
                "bootstrap state is current, but DSM did not start the package as root"
            exit 1
        fi

        if ! ensure_tun_created; then
            exit 1
        fi

        if ! apply_routing_sysctls; then
            exit 1
        fi

        if ! check_netfilter_prerequisites; then
            exit 1
        fi

        start_daemon

        if ! wait_for_status 0; then
            log_message ERROR \
                "tailscaled did not remain running after startup"
            stop_daemon
            exit 1
        fi

        if ! wait_for_localapi; then
            stop_daemon
            exit 1
        fi

        if ! start_reconciler; then
            stop_daemon
            exit 1
        fi

        exit 0
    fi
    ;;
stop)
    STOP_STATUS=0

    if reconciler_status; then
        stop_reconciler ||
            STOP_STATUS=1
    fi

    if daemon_status; then
        stop_daemon ||
            STOP_STATUS=1
    fi

    exit "${STOP_STATUS}"
    ;;
status)
    if daemon_status; then
        echo "${SERVICE_NAME} is running"

        if reconciler_status; then
            echo "netfilter reconciler is running"
        else
            echo "netfilter reconciler is not running"
        fi

        exit 0
    else
        if ! bootstrap_is_current; then
            echo "${SERVICE_NAME} requires administrator bootstrap"
            echo "Run: ${BOOTSTRAP_COMMAND}"
        fi

        echo "${SERVICE_NAME} is not running"
        exit 3
    fi
    ;;
log)
    exit 0
    ;;
*)
    echo "command $1 is not implemented"
    exit 0
    ;;
esac
