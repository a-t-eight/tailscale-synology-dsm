#!/bin/bash

SERVICE_NAME="tailscale"

# DSM package services receive a restricted environment. Include the standard
# system paths required for ip, iptables, ip6tables, nft, and related tools.
export PATH="${SYNOPKG_PKGDEST}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Route subnet traffic through the Linux kernel rather than netstack.
export TS_DEBUG_NETSTACK_SUBNETS=false

if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -eq "6" ]; then
    PKGVAR="/var/packages/Tailscale/etc"
else
    PKGVAR="${SYNOPKG_PKGVAR}"
fi

PKG_NAME="${SYNOPKG_PKGNAME:-Tailscale}"
PKG_ROOT="${TAILSCALE_SYNOLOGY_PACKAGE_ROOT:-/var/packages/${PKG_NAME}}"

BOOTSTRAP_STATE_FILE="${PKGVAR}/root-bootstrap.state"
ACTIVE_PRIVILEGE_FILE="${PKG_ROOT}/conf/privilege"
ROOT_PRIVILEGE_TEMPLATE="${PKG_ROOT}/conf/privilege.bootstrap-root"
BOOTSTRAP_COMMAND="sudo ${PKG_ROOT}/scripts/tailscale-synology-bootstrap install"

PID_FILE="${PKGVAR}/tailscaled.pid"
LOG_FILE="${PKGVAR}/tailscaled.stdout.log"
STATE_FILE="${PKGVAR}/tailscaled.state"
SOCKET_FILE="${PKGVAR}/tailscaled.sock"
PORT="41641"

SERVICE_COMMAND="${SYNOPKG_PKGDEST}/bin/tailscaled \
--state=${STATE_FILE} \
--socket=${SOCKET_FILE} \
--port=${PORT} \
--tun=tailscale0"

if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -eq "6" ]; then
    chown -R tailscale:tailscale "${PKGVAR}/"
fi

start_daemon() {
    local ts=$(date --iso-8601=second)
    echo "${ts} Starting ${SERVICE_NAME} with: ${SERVICE_COMMAND}" >${LOG_FILE}
    STATE_DIRECTORY=${PKGVAR} ${SERVICE_COMMAND} 2>&1 | sed -u '1,200p;201s,.*,[further tailscaled logs suppressed],p;d' >>${LOG_FILE} &
    # We pipe tailscaled's output to sed, so "$!" retrieves the PID of sed not tailscaled.
    # Use jobs -p to retrieve the PID of the most recent process group leader.
    jobs -p >"${PID_FILE}"
}

stop_daemon() {
    if [ -r "${PID_FILE}" ]; then
        local PID=$(cat "${PID_FILE}")
        local ts=$(date --iso-8601=second)
        echo "${ts} Stopping ${SERVICE_NAME} service PID=${PID}" >>${LOG_FILE}
        kill -TERM $PID >>${LOG_FILE} 2>&1
        wait_for_status 1 || kill -KILL $PID >>${LOG_FILE} 2>&1
        rm -f "${PID_FILE}" >/dev/null
    fi
}

daemon_status() {
    if [ -r "${PID_FILE}" ]; then
        local PID=$(cat "${PID_FILE}")
        if ps -o pid -p ${PID} > /dev/null; then
            return
        fi
        rm -f "${PID_FILE}" >/dev/null
    fi
    return 1
}

wait_for_status() {
    # 20 tries
    # sleeps for 1 second after each try
    local counter=20
    while [ ${counter} -gt 0 ]; do
        daemon_status
        [ $? -eq $1 ] && return
        counter=$((counter - 1))
        sleep 1
    done
    return 1
}

log_message() {
    local level="$1"
    shift

    local ts
    ts=$(date --iso-8601=second)

    echo "${ts} ${level}: $*" >&2
    echo "${ts} ${level}: $*" >>"${LOG_FILE}"
}

sha256_file() {
    local file="$1"

    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "${file}" | awk '{print $1}'
        return
    fi

    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "${file}" | awk '{print $1}'
        return
    fi

    if command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "${file}" | awk '{print $NF}'
        return
    fi

    return 127
}

bootstrap_state_value() {
    local key="$1"

    awk -F= -v key="${key}" '
        $1 == key {
            sub(/^[^=]*=/, "")
            print
            exit
        }
    ' "${BOOTSTRAP_STATE_FILE}"
}

bootstrap_is_current() {
    local stored_binary_hash
    local stored_privilege_hash
    local current_binary_hash
    local current_privilege_hash

    if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -ne "7" ]; then
        return 0
    fi

    [ -r "${BOOTSTRAP_STATE_FILE}" ] || return 1
    [ -r "${ACTIVE_PRIVILEGE_FILE}" ] || return 1
    [ -r "${ROOT_PRIVILEGE_TEMPLATE}" ] || return 1
    [ -x "${SYNOPKG_PKGDEST}/bin/tailscaled" ] || return 1

    [ "$(bootstrap_state_value schema)" = "1" ] || return 1
    [ "$(bootstrap_state_value mode)" = "root" ] || return 1

    stored_binary_hash="$(
        bootstrap_state_value tailscaled_sha256
    )"

    stored_privilege_hash="$(
        bootstrap_state_value privilege_sha256
    )"

    [ -n "${stored_binary_hash}" ] || return 1
    [ -n "${stored_privilege_hash}" ] || return 1

    current_binary_hash="$(
        sha256_file "${SYNOPKG_PKGDEST}/bin/tailscaled"
    )" || return 1

    current_privilege_hash="$(
        sha256_file "${ROOT_PRIVILEGE_TEMPLATE}"
    )" || return 1

    [ "${stored_binary_hash}" = "${current_binary_hash}" ] ||
        return 1

    [ "${stored_privilege_hash}" = "${current_privilege_hash}" ] ||
        return 1

    cmp -s \
        "${ACTIVE_PRIVILEGE_FILE}" \
        "${ROOT_PRIVILEGE_TEMPLATE}" ||
        return 1

    return 0
}

log_bootstrap_required() {
    log_message NOTICE \
        "Tailscale is installed but requires administrator bootstrap."

    log_message NOTICE \
        "Run: ${BOOTSTRAP_COMMAND}"
}


check_iptables_chain() {
    local table="$1"
    local chain="$2"
    local output

    if ! output="$(
        "${IPTABLES_BIN}" \
            -t "${table}" \
            -S "${chain}" \
            2>&1
    )"; then
        log_message ERROR \
            "cannot access iptables ${table}/${chain}: ${output}"
        return 1
    fi

    return 0
}


check_iptables_rule_support() {
    local description="$1"
    local table="$2"
    local chain="$3"
    local output
    local status

    shift 3

    output="$(
        "${IPTABLES_BIN}" \
            -t "${table}" \
            -C "${chain}" \
            "$@" \
            2>&1
    )"
    status=$?

    case "${status}" in
    0)
        # An identical rule already exists.
        return 0
        ;;
    1)
        # Accept only the normal diagnostic for a valid rule that is absent.
        # Other status-1 failures can indicate a missing match, target,
        # extension, table, chain, or kernel feature.
        case "${output}" in
        *"does a matching rule exist"*)
            return 0
            ;;
        *)
            log_message ERROR \
                "iptables prerequisite ${description} failed: ${output}"
            return 1
            ;;
        esac
        ;;
    *)
        log_message ERROR \
            "iptables prerequisite ${description} failed: ${output}"
        return 1
        ;;
    esac
}


check_netfilter_prerequisites() {
    if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -ne "7" ]; then
        return 0
    fi

    IPTABLES_BIN="$(command -v iptables 2>/dev/null)" || {
        log_message ERROR \
            "iptables was not found in PATH"
        return 1
    }

    check_iptables_chain filter INPUT ||
        return 1

    check_iptables_chain filter FORWARD ||
        return 1

    check_iptables_chain nat POSTROUTING ||
        return 1

    check_iptables_chain mangle PREROUTING ||
        return 1

    check_iptables_chain mangle OUTPUT ||
        return 1

    check_iptables_chain mangle FORWARD ||
        return 1

    check_iptables_rule_support \
        "MARK target" \
        filter \
        FORWARD \
        -j MARK --set-mark 0x40000/0xff0000 ||
        return 1

    check_iptables_rule_support \
        "mark match" \
        filter \
        FORWARD \
        -m mark --mark 0x40000/0xff0000 \
        -j ACCEPT ||
        return 1

    check_iptables_rule_support \
        "conntrack match" \
        filter \
        FORWARD \
        -m conntrack \
        ! --ctstate ESTABLISHED,RELATED \
        -j DROP ||
        return 1

    check_iptables_rule_support \
        "CONNMARK restore target" \
        mangle \
        PREROUTING \
        -m conntrack \
        --ctstate ESTABLISHED,RELATED \
        -j CONNMARK \
        --restore-mark \
        --nfmask 0xff0000 \
        --ctmask 0xff0000 ||
        return 1

    check_iptables_rule_support \
        "CONNMARK save target" \
        mangle \
        OUTPUT \
        -m conntrack \
        --ctstate NEW \
        -m mark \
        ! --mark 0x0/0xff0000 \
        -j CONNMARK \
        --save-mark \
        --nfmask 0xff0000 \
        --ctmask 0xff0000 ||
        return 1

    check_iptables_rule_support \
        "MASQUERADE target" \
        nat \
        POSTROUTING \
        -m mark \
        --mark 0x40000/0xff0000 \
        -j MASQUERADE ||
        return 1

    check_iptables_rule_support \
        "TCPMSS target" \
        mangle \
        FORWARD \
        -p tcp \
        --tcp-flags SYN,RST SYN \
        -j TCPMSS \
        --clamp-mss-to-pmtu ||
        return 1

    return 0
}

ensure_tun_created() {
    if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -eq "7" ]; then
        if [ ! -c /dev/net/tun ]; then
            log_message ERROR \
                "/dev/net/tun is unavailable; install and load the TUN kernel module before starting Tailscale."
            return 1
        fi
        return 0
    fi
    # Create the necessary file structure for /dev/net/tun
    if ([ ! -c /dev/net/tun ]); then
        if ([ ! -d /dev/net ]); then
            mkdir -m 755 /dev/net
        fi
        mknod /dev/net/tun c 10 200
        chmod 0755 /dev/net/tun
    fi

    # Load the tun module if not already loaded
    if (!(lsmod | grep -q "^tun\s")); then
        insmod /lib/modules/tun.ko
    fi
}

case $1 in
start)
    if daemon_status; then
        exit 0
    else
        if ! bootstrap_is_current; then
            log_bootstrap_required
            exit 0
        fi

        if [ "$(id -u 2>/dev/null)" != "0" ]; then
            log_message ERROR \
                "bootstrap state is current, but DSM did not start the package as root"
            exit 1
        fi

        if ! ensure_tun_created; then
            exit 1
        fi

        if ! check_netfilter_prerequisites; then
            exit 1
        fi

        start_daemon
        exit $?
    fi
    ;;
stop)
    if daemon_status; then
        stop_daemon
        exit $?
    else
        exit 0
    fi
    ;;
status)
    if daemon_status; then
        echo "${SERVICE_NAME} is running"
        exit 0
    else
        if ! bootstrap_is_current; then
            echo "${SERVICE_NAME} requires administrator bootstrap"
            echo "Run: ${BOOTSTRAP_COMMAND}"
        fi

        echo "${SERVICE_NAME} is not running"
        exit 3
    fi
    ;;
log)
    exit 0
    ;;
*)
    echo "command $1 is not implemented"
    exit 0
    ;;
esac
