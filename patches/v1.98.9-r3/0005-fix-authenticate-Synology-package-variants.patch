@@ -199,6 +199,66 @@ func TestDSM7SPKContainsRootControlManifest(t *testing.T) {
 	}
 }
 
+func TestDSM7PackageModeTemplateMatchesActivePrivilege(t *testing.T) {
+	innerPath := writeTestInnerPackage(t,
+		testTarMember{name: "bin/tailscale", mode: 0755, data: []byte("cli\n")},
+		testTarMember{name: "bin/tailscaled", mode: 0755, data: []byte("daemon\n")},
+	)
+	tests := []struct {
+		name   string
+		target target
+	}{
+		{"sideload", target{filenameArch: "x86_64", dsmMajorVersion: 7}},
+		{"package-center", target{filenameArch: "x86_64", dsmMajorVersion: 7, dsmMinorVersion: 2, packageCenter: true}},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			build := r3TestBuild()
+			build.Out = t.TempDir()
+			files, err := test.target.buildSPK(build, &innerPkg{path: innerPath})
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			archive, err := os.Open(files[0])
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer archive.Close()
+
+			members := map[string][]byte{}
+			reader := tar.NewReader(archive)
+			for {
+				header, err := reader.Next()
+				if err == io.EOF {
+					break
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				switch header.Name {
+				case "conf/privilege", "conf/privilege.bootstrap-package", "conf/root-payload.manifest":
+					members[header.Name], err = io.ReadAll(reader)
+					if err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+
+			active := members["conf/privilege"]
+			safe := members["conf/privilege.bootstrap-package"]
+			if !bytes.Equal(active, safe) {
+				t.Fatal("active package privilege differs from immutable safe template")
+			}
+			wantRecord := manifestLine(0644, "conf/privilege.bootstrap-package", safe)
+			if !strings.Contains(string(members["conf/root-payload.manifest"]), wantRecord+"\n") {
+				t.Fatalf("root payload manifest does not authenticate selected safe template: %s", wantRecord)
+			}
+		})
+	}
+}
