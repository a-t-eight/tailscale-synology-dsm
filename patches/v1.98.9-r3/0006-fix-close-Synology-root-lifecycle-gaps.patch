+test_concurrent_target_mutation_is_detected() {
+  local checkpoint
+
+  for checkpoint in before-target-copy after-staged-verification; do
+    setup_fixture
+    load_bootstrap
+
+    tailscale_synology_bootstrap_test_checkpoint() {
+      local stage="$1"
+      local relative="$2"
+      local source="$3"
+      local staged="$4"
+
+      [ "${stage}" = "${checkpoint}" ] || return 0
+      [ "${relative}" = target/bin/tailscale ] || return 0
+
+      if [ "${stage}" = before-target-copy ]; then
+        printf 'concurrent-source-mutation\n' >>"${source}"
+      else
+        printf 'concurrent-staged-mutation\n' >>"${staged}"
+      fi
+    }
+
+    capture_main install
+    assert_nonzero_status "${CAPTURED_STATUS}"
+    assert_files_equal \
+      "${PACKAGE_ROOT}/conf/privilege" \
+      "${PACKAGE_ROOT}/conf/privilege.bootstrap-package"
+    assert_file_absent \
+      "${PACKAGE_ROOT}/conf/root-control/root-bootstrap.state"
+  done
+}
+
+test_promotion_failures_roll_back_each_stage() {
+  local checkpoint
+
+  for checkpoint in \
+    after-target-promotion \
+    before-state-write \
+    before-privilege-install \
+    before-legacy-cleanup \
+    before-transaction-cleanup; do
+    setup_fixture
+    load_bootstrap
+
+    tailscale_synology_bootstrap_test_checkpoint() {
+      [ "$1" != "${checkpoint}" ]
+    }
+
+    capture_main install
+    assert_nonzero_status "${CAPTURED_STATUS}"
+    assert_files_equal \
+      "${PACKAGE_ROOT}/conf/privilege" \
+      "${PACKAGE_ROOT}/conf/privilege.bootstrap-package"
+    assert_file_absent \
+      "${PACKAGE_ROOT}/conf/root-control/root-bootstrap.state"
+    assert_directory_empty \
+      "${PACKAGE_ROOT}/conf/root-control/transactions"
+  done
+}
+
+test_failed_rollback_retains_one_blocking_transaction() {
+  setup_fixture
+  load_bootstrap
+
+  tailscale_synology_bootstrap_test_checkpoint() {
+    case "$1" in
+    after-transaction-create)
+      return 1
+      ;;
+    before-rollback-restore)
+      return 1
+      ;;
+    esac
+  }
+
+  capture_main install
+  assert_nonzero_status "${CAPTURED_STATUS}"
+
+  if [ "$(find "${PACKAGE_ROOT}/conf/root-control/transactions" \
+    -mindepth 1 -maxdepth 1 -type d | wc -l)" -ne 1 ]; then
+    fail "failed rollback did not retain exactly one transaction"
+  fi
+
+  unset -f tailscale_synology_bootstrap_test_checkpoint
+  capture_main install
+  assert_nonzero_status "${CAPTURED_STATUS}"
+  assert_contains "${CAPTURED_OUTPUT}" \
+    "an incomplete bootstrap transaction requires attended recovery"
+}
+
+test_transaction_backup_substitution_is_retained_for_recovery() {
+  setup_fixture
+  load_bootstrap
+
+  tailscale_synology_bootstrap_test_checkpoint() {
+    local transaction
