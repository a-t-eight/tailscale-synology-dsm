+    [ "$1" = after-transaction-create ] || return 0
+    transaction="$2"
+    rm "${transaction}/privilege"
+    ln -s "${PACKAGE_ROOT}/conf/privilege.bootstrap-package" \
+      "${transaction}/privilege"
