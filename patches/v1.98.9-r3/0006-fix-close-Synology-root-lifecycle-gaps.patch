+terminate_reconciler_process() {
+    local pid="$1"
+    local counter="$2"
+    local kill_wait=2
+
+    kill -0 -- "${pid}" >/dev/null 2>&1 ||
+        return 0
+    process_cmdline_has_arg "${pid}" "${RECONCILER_SCRIPT}" ||
+        return 1
+
+    kill -TERM -- "${pid}" >/dev/null 2>&1 ||
+        true
+
+    while [ "${counter}" -gt 0 ] &&
+        kill -0 -- "${pid}" >/dev/null 2>&1
+    do
+        counter=$((counter - 1))
+        sleep 1
+    done
+
+    if kill -0 -- "${pid}" >/dev/null 2>&1; then
+        if ! process_cmdline_has_arg "${pid}" "${RECONCILER_SCRIPT}"; then
+            wait "${pid}" >/dev/null 2>&1 ||
+                true
+            ! kill -0 -- "${pid}" >/dev/null 2>&1
+            return $?
+        fi
+
+        log_message WARNING \
+            "netfilter reconciler did not stop after SIGTERM; sending SIGKILL"
+        kill -KILL -- "${pid}" >/dev/null 2>&1 ||
+            true
+
+        wait "${pid}" >/dev/null 2>&1 ||
+            true
+
+        while [ "${kill_wait}" -gt 0 ] &&
+            kill -0 -- "${pid}" >/dev/null 2>&1
+        do
+            kill_wait=$((kill_wait - 1))
+            sleep 1
+        done
+    fi
+
+    ! kill -0 -- "${pid}" >/dev/null 2>&1
+}
+
