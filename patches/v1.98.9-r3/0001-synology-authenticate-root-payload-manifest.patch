+func buildRootPayloadManifest(innerPath string, dsmVersion int) ([]byte, error) {
+	if dsmVersion != 7 {
+		return nil, fmt.Errorf("root payload manifest is unsupported for DSM %d", dsmVersion)
+	}
+
+	innerFile, err := os.Open(innerPath)
+	if err != nil {
+		return nil, err
+	}
+	defer innerFile.Close()
+
+	gzipReader, err := gzip.NewReader(innerFile)
+	if err != nil {
+		return nil, err
+	}
+	defer gzipReader.Close()
+
+	var records []rootPayloadManifestRecord
+	seen := map[string]bool{}
+	tarReader := tar.NewReader(gzipReader)
+	for {
+		header, err := tarReader.Next()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return nil, err
+		}
+
+		memberName := strings.TrimSuffix(header.Name, "/")
+		cleanName := path.Clean(memberName)
+		if memberName == "" || cleanName == "." || path.IsAbs(memberName) || cleanName != memberName || strings.HasPrefix(cleanName, "../") {
+			return nil, fmt.Errorf("unsafe inner package member %q", header.Name)
+		}
+
+		manifestPath := path.Join("target", cleanName)
+		if seen[manifestPath] {
+			return nil, fmt.Errorf("duplicate inner package member %q", header.Name)
+		}
+		seen[manifestPath] = true
+
+		switch header.Typeflag {
+		case tar.TypeDir:
+			continue
+		case tar.TypeReg, tar.TypeRegA:
+			hasher := sha256.New()
+			if _, err := io.Copy(hasher, tarReader); err != nil {
+				return nil, err
+			}
+			var digest [sha256.Size]byte
+			copy(digest[:], hasher.Sum(nil))
+			records = append(records, rootPayloadManifestRecord{
+				path:   manifestPath,
+				mode:   header.Mode & 0777,
+				digest: digest,
+			})
+		default:
+			return nil, fmt.Errorf("unsupported inner package member type %d for %q", header.Typeflag, header.Name)
+		}
+	}
+
+	for _, file := range rootPayloadOuterFiles {
+		data, err := files.ReadFile("files/" + file.source)
+		if err != nil {
+			return nil, err
+		}
+		if seen[file.path] {
+			return nil, fmt.Errorf("duplicate root payload path %q", file.path)
+		}
+		seen[file.path] = true
+		records = append(records, rootPayloadManifestRecord{
+			path:   file.path,
+			mode:   file.mode,
+			digest: sha256.Sum256(data),
+		})
+	}
+
+	sort.Slice(records, func(i, j int) bool {
+		return records[i].path < records[j].path
+	})
+
+	var manifest bytes.Buffer
+	fmt.Fprintln(&manifest, rootPayloadManifestHeader)
+	for _, record := range records {
+		fmt.Fprintf(&manifest, "file %04o %x %s\n", record.mode, record.digest, record.path)
+	}
+	return manifest.Bytes(), nil
+}
