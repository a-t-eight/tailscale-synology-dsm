+func TestDSM7SPKContainsRootControlManifest(t *testing.T) {
+	innerPath := writeTestInnerPackage(t,
+		testTarMember{name: "bin/tailscale", mode: 0755, data: []byte("cli\n")},
+		testTarMember{name: "bin/tailscaled", mode: 0755, data: []byte("daemon\n")},
+	)
+	build := r3TestBuild()
+	build.Out = t.TempDir()
+
+	files, err := (&target{filenameArch: "x86_64", dsmMajorVersion: 7}).buildSPK(
+		build,
+		&innerPkg{path: innerPath},
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	archive, err := os.Open(files[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer archive.Close()
+
+	wanted := map[string]bool{
+		"conf/root-control/":         false,
+		"conf/root-payload.manifest": false,
+	}
+	reader := tar.NewReader(archive)
+	for {
+		header, err := reader.Next()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, ok := wanted[header.Name]; ok {
+			wanted[header.Name] = true
+		}
+	}
+	for name, found := range wanted {
+		if !found {
+			t.Fatalf("SPK missing %s", name)
+		}
+	}
+}
