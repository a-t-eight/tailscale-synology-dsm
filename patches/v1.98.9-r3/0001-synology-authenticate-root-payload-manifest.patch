+type testTarMember struct {
+	name string
+	mode int64
+	data []byte
+	kind byte
+}
+
+func writeTestInnerPackage(t *testing.T, members ...testTarMember) string {
+	t.Helper()
+
+	path := filepath.Join(t.TempDir(), "package.tgz")
+	file, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	gzipWriter := gzip.NewWriter(file)
+	tarWriter := tar.NewWriter(gzipWriter)
+
+	for _, member := range members {
+		header := &tar.Header{
+			Name:     member.name,
+			Mode:     member.mode,
+			Size:     int64(len(member.data)),
+			Typeflag: member.kind,
+		}
+		if header.Typeflag == 0 {
+			header.Typeflag = tar.TypeReg
+		}
+		if err := tarWriter.WriteHeader(header); err != nil {
+			t.Fatal(err)
+		}
+		if header.Typeflag == tar.TypeReg {
+			if _, err := tarWriter.Write(member.data); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+
+	if err := tarWriter.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := gzipWriter.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := file.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	return path
+}
+
+func manifestLine(mode int64, path string, data []byte) string {
+	return fmt.Sprintf("file %04o %x %s", mode, sha256.Sum256(data), path)
+}
+
+func TestRootPayloadManifestIsCompleteAndDeterministic(t *testing.T) {
+	tailscaled := []byte("synthetic tailscaled\n")
+	config := []byte("synthetic config\n")
+	inner := writeTestInnerPackage(t,
+		testTarMember{name: "ui/config", mode: 0644, data: config},
+		testTarMember{name: "bin/tailscaled", mode: 0755, data: tailscaled},
+	)
+
+	manifest, err := buildRootPayloadManifest(inner, 7)
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(manifest)
+
+	if !strings.HasPrefix(text, rootPayloadManifestHeader+"\n") {
+		t.Fatalf("manifest header missing:\n%s", text)
+	}
+	for _, want := range []string{
+		manifestLine(0755, "target/bin/tailscaled", tailscaled),
+		manifestLine(0644, "target/ui/config", config),
+		" scripts/start-stop-status",
+		" scripts/tailscale-synology-bootstrap",
+		" scripts/tailscale-netfilter-reconciler",
+		" conf/resource",
+		" conf/PKG_DEPS",
+		" conf/privilege.bootstrap-package",
+		" conf/privilege.bootstrap-root",
+	} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("manifest missing %q:\n%s", want, text)
+		}
+	}
+
+	lines := strings.Split(strings.TrimSpace(text), "\n")
+	for index := 2; index < len(lines); index++ {
+		previousPath := strings.Fields(lines[index-1])[3]
+		currentPath := strings.Fields(lines[index])[3]
+		if previousPath >= currentPath {
+			t.Fatalf("manifest paths are not strictly sorted at %q then %q", previousPath, currentPath)
+		}
+	}
+}
+
+func TestRootPayloadManifestRejectsUnsafeInnerMembers(t *testing.T) {
+	tests := map[string][]testTarMember{
+		"parent traversal": {
+			{name: "../escape", mode: 0755, data: []byte("unsafe\n")},
+		},
+		"absolute path": {
+			{name: "/bin/escape", mode: 0755, data: []byte("unsafe\n")},
+		},
+		"non-normal path": {
+			{name: "bin/../escape", mode: 0755, data: []byte("unsafe\n")},
+		},
+		"symbolic link": {
+			{name: "bin/link", mode: 0755, kind: tar.TypeSymlink},
+		},
+		"fifo": {
+			{name: "bin/fifo", mode: 0755, kind: tar.TypeFifo},
+		},
+		"duplicate": {
+			{name: "bin/tailscale", mode: 0755, data: []byte("first\n")},
+			{name: "bin/tailscale", mode: 0755, data: []byte("second\n")},
+		},
+	}
+
+	for name, members := range tests {
+		t.Run(name, func(t *testing.T) {
+			inner := writeTestInnerPackage(t, members...)
+			if _, err := buildRootPayloadManifest(inner, 7); err == nil {
+				t.Fatal("unsafe inner package member was accepted")
+			}
+		})
+	}
+}
