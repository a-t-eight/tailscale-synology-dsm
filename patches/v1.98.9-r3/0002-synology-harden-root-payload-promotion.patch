+manifest_record() {
+  local mode="$1"
+  local relative="$2"
+  local absolute="$3"
+
+  printf 'file %s %s %s\n' \
+    "${mode}" \
+    "$(sha256sum "${absolute}" | awk '{print $1}')" \
+    "${relative}"
+}
