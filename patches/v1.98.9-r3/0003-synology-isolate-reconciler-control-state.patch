 reconciler_status() {
-    if reconciler_pid >/dev/null 2>&1; then
+    reconciler_pid >/dev/null 2>&1
+}
+
+
+reconciler_runtime_owner_is_root() {
+    local path="$1"
+
+    if [ "${TAILSCALE_SYNOLOGY_TEST_MODE:-0}" = "1" ]; then
+        return 0
+    fi
+
+    [ "$(stat -c %u -- "${path}")" = "0" ] &&
+        [ "$(stat -c %g -- "${path}")" = "0" ]
+}
+
+
+reconciler_runtime_dir_is_secure() {
+    [ -d "${RECONCILER_RUNTIME_DIR}" ] &&
+        [ ! -L "${RECONCILER_RUNTIME_DIR}" ] &&
+        [ "$(stat -c %a -- "${RECONCILER_RUNTIME_DIR}")" = "700" ] &&
+        reconciler_runtime_owner_is_root "${RECONCILER_RUNTIME_DIR}"
+}
+
+
+reconciler_runtime_file_is_secure() {
+    local path="$1"
+
+    [ -f "${path}" ] &&
+        [ ! -L "${path}" ] &&
+        [ "$(stat -c %h -- "${path}")" = "1" ] &&
+        [ "$(stat -c %a -- "${path}")" = "600" ] &&
+        reconciler_runtime_owner_is_root "${path}"
+}
+
+
+ensure_reconciler_runtime_dir() {
+    [ "$(id -u 2>/dev/null)" = "0" ] || return 1
+
+    if [ ! -e "${RECONCILER_RUNTIME_DIR}" ] &&
+        [ ! -L "${RECONCILER_RUNTIME_DIR}" ]; then
+        mkdir -m 0700 -- "${RECONCILER_RUNTIME_DIR}" || return 1
+        chown root:root "${RECONCILER_RUNTIME_DIR}" || return 1
+    fi
+
+    reconciler_runtime_dir_is_secure || return 1
+
+    if [ -e "${RECONCILER_PENDING_FILE}" ] ||
+        [ -L "${RECONCILER_PENDING_FILE}" ]; then
+        reconciler_runtime_file_is_secure "${RECONCILER_PENDING_FILE}" || return 1
+    fi
+
+    return 0
+}
+
+
+cleanup_stale_reconciler_pid() {
+    [ "$(id -u 2>/dev/null)" = "0" ] || return 1
+
+    if [ ! -e "${RECONCILER_PID_FILE}" ] &&
+        [ ! -L "${RECONCILER_PID_FILE}" ]; then
         return 0
     fi
 
+    reconciler_runtime_file_is_secure "${RECONCILER_PID_FILE}" || return 1
+    reconciler_pid >/dev/null 2>&1 && return 0
     rm -f -- "${RECONCILER_PID_FILE}"
