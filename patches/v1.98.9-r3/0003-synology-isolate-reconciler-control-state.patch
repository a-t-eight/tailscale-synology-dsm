+
+
+manifest_file_digest() {
+    local wanted="$1"
+
+    awk -v wanted="${wanted}" '
+        NR == 1 {
+            if ($0 != "tailscale-synology-root-payload-v1") {
+                exit 2
+            }
+            next
+        }
+
+        $1 == "file" && $4 == wanted {
+            if (found) {
+                exit 2
+            }
+            digest = $3
+            found = 1
+        }
+
+        END {
+            if (!found) {
+                exit 1
+            }
+            print digest
+        }
+    ' "${ROOT_PAYLOAD_MANIFEST}"
+}
