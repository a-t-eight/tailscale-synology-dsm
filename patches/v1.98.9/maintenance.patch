+check_iptables_chain() {
+    local table="$1"
+    local chain="$2"
+    local output
+    local status
+
+    output="$(
+        "${IPTABLES_BIN}" \
+            -t "${table}" \
+            -S \
+            2>&1
+    )"
+    status=$?
+
+    if [ "${status}" -ne 0 ]; then
+        log_message ERROR \
+            "cannot access iptables ${table} table: ${output}"
+        return 1
+    fi
+
+    if ! printf '%s\n' "${output}" |
+        awk -v wanted="${chain}" '
+            ($1 == "-P" || $1 == "-N") &&
+            $2 == wanted {
+                found = 1
+                exit
+            }
+
+            END {
+                exit found ? 0 : 1
+            }
+        '
+    then
+        log_message ERROR \
+            "required iptables chain ${table}/${chain} is unavailable"
+        return 1
+    fi
+
+    return 0
+}
