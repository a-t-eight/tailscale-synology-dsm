+func (n *fakeIPTablesRunner) HasTailscaleHooks() (bool, error) {
+	checks := []iptRule{
+		{
+			chain: "filter/INPUT",
+			rule:  "-j ts-input",
+		},
+		{
+			chain: "filter/FORWARD",
+			rule:  "-j ts-forward",
+		},
+		{
+			chain: "nat/POSTROUTING",
+			rule:  "-j ts-postrouting",
+		},
+	}
+
+	for _, ipt := range []map[string][]string{
+		n.ipt4,
+		n.ipt6,
+	} {
+		for _, check := range checks {
+			rules, ok := ipt[check.chain]
+			if !ok ||
+				!slices.Contains(
+					rules,
+					check.rule,
+				) {
+				return false, nil
+			}
+		}
+	}
+
+	return true, nil
