+        -F "${chain}" \
+        >/dev/null 2>&1 ||
+        failed=1
+
+    "${IPTABLES_BIN}" \
+        -t "${table}" \
+        -X "${chain}" \
+        >/dev/null 2>&1 ||
+        failed=1
+
+    return "${failed}"
+}
