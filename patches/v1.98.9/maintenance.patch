+secure_root_path() {
+    local path="$1"
+    local uid
+    local mode
+    local mode_value
+
+    [ -e "${path}" ] || return 1
+
+    uid="$(stat -c %u -- "${path}")" ||
+        return 1
+
+    [ "${uid}" = "0" ] ||
+        return 1
+
+    mode="$(stat -c %a -- "${path}")" ||
+        return 1
+
+    mode_value=$((8#${mode}))
+
+    if (( mode_value & 8#022 )); then
+        return 1
+    fi
+
+    return 0
