@@ -38,6 +38,11 @@ TAILSCALE_BIN="${SYNOPKG_PKGDEST}/bin/tailscale"
 
 NETFILTER_LOCALAPI_ATTEMPTS="${TAILSCALE_SYNOLOGY_LOCALAPI_ATTEMPTS:-30}"
 
+TUN_DEVICE="${TAILSCALE_SYNOLOGY_TUN_DEVICE:-/dev/net/tun}"
+TUN_PROC_MISC="${TAILSCALE_SYNOLOGY_TUN_PROC_MISC:-/proc/misc}"
+TUN_WAIT_ATTEMPTS="${TAILSCALE_SYNOLOGY_TUN_WAIT_ATTEMPTS:-10}"
+TUN_WAIT_SECONDS="${TAILSCALE_SYNOLOGY_TUN_WAIT_SECONDS:-1}"
+
 RECONCILER_SCRIPT="${PKG_ROOT}/scripts/tailscale-netfilter-reconciler"
