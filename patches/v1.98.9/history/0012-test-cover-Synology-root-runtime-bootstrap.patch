+run_case() {
+  local name="$1"
+  local function_name="$2"
+
+  printf 'TEST: %s ... ' "${name}"
+
+  if (
+    set -euo pipefail
+    "${function_name}"
+  ); then
+    printf 'PASS\n'
+    PASS_COUNT=$((PASS_COUNT + 1))
+  else
+    printf 'FAIL\n'
+    FAIL_COUNT=$((FAIL_COUNT + 1))
+  fi
+}
+
+run_case \
+  "process override requires explicit test mode" \
+  test_process_override_guard
+
+run_case \
+  "status before bootstrap" \
+  test_status_before_bootstrap
+
+run_case \
+  "non-root install is rejected" \
+  test_non_root_install_rejected
+
+run_case \
+  "invalid root template is rejected" \
+  test_invalid_root_template_rejected
+
+run_case \
+  "insecure bootstrap script is rejected" \
+  test_insecure_bootstrap_script_rejected
+
+run_case \
+  "successful root runtime bootstrap" \
+  test_successful_root_install
+
+run_case \
+  "state hashes match installed artifacts" \
+  test_state_hashes
+
+run_case \
+  "stale binary is rejected by startup gate" \
+  test_stale_binary_rejected_by_startup_gate
+
+run_case \
+  "stale privilege template is rejected by startup gate" \
+  test_stale_privilege_rejected_by_startup_gate
+
+run_case \
+  "safe manifest with old state is rejected" \
+  test_safe_manifest_with_old_state_rejected
+
+run_case \
+  "unsafe ownership and modes are rejected" \
+  test_insecure_ownership_rejected_by_startup_gate
+
+run_case \
+  "non-root daemon causes rollback" \
+  test_non_root_daemon_rolls_back
+
+run_case \
+  "failed package start causes rollback" \
+  test_failed_start_rolls_back
+
+run_case \
+  "remove restores safe package state" \
+  test_remove_restores_safe_state
+
+printf '\nResults: %s passed, %s failed\n' \
+  "${PASS_COUNT}" \
+  "${FAIL_COUNT}"
+
+if [ "${FAIL_COUNT}" -ne 0 ]; then
+  exit 1
+fi
