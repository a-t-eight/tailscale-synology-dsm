+#!/bin/bash
+
+set -euo pipefail
+SCRIPT_DIR="$(
+  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &&
+    pwd
+)"
+
+REPO_ROOT="$(
+  cd -- "${SCRIPT_DIR}/../../../.." &&
+    pwd
+)"
+
+BOOTSTRAP_SOURCE="${REPO_ROOT}/release/dist/synology/files/scripts/tailscale-synology-bootstrap"
+START_STOP_SOURCE="${REPO_ROOT}/release/dist/synology/files/scripts/start-stop-status"
+SAFE_SOURCE="${REPO_ROOT}/release/dist/synology/files/privilege-dsm7"
+ROOT_SOURCE="${REPO_ROOT}/release/dist/synology/files/privilege-dsm7.root"
+TEST_ROOT="$(mktemp -d)"
+PASS_COUNT=0
+FAIL_COUNT=0
+
+cleanup() {
+  rm -rf -- "${TEST_ROOT}"
+}
+
+trap cleanup EXIT
+
+for required_file in \
+  "${BOOTSTRAP_SOURCE}" \
+  "${START_STOP_SOURCE}" \
+  "${SAFE_SOURCE}" \
+  "${ROOT_SOURCE}"; do
+
+  if [ ! -f "${required_file}" ]; then
+    printf 'ERROR: required test input is missing: %s\n' \
+      "${required_file}" >&2
+    exit 1
+  fi
+done
+
+fail() {
+  printf 'ERROR: %s\n' "$*" >&2
+  exit 1
+}
+
+assert_status() {
+  local expected="$1"
+  local actual="$2"
+
+  if [ "${actual}" -ne "${expected}" ]; then
+    fail "expected status ${expected}, received ${actual}"
+  fi
+}
+
+assert_nonzero_status() {
+  local actual="$1"
+
+  if [ "${actual}" -eq 0 ]; then
+    fail "expected command failure, but it succeeded"
+  fi
+}
+
+assert_contains() {
+  local value="$1"
+  local expected="$2"
+  case "${value}" in
+  *"${expected}"*)
+    ;;
+  *)
+
+    printf 'ERROR: expected output to contain:\n  %s\n' \
+      "${expected}" >&2
+    printf 'Actual output:\n%s\n' "${value}" >&2
+    exit 1
+    ;;
+  esac
+}
+
+assert_file_absent() {
+  local path="$1"
+
+  if [ -e "${path}" ]; then
+    fail "expected file to be absent: ${path}"
+  fi
+}
+
+assert_files_equal() {
+  local first="$1"
+  local second="$2"
+
+  cmp -s -- "${first}" "${second}" ||
+    fail "files differ: ${first} and ${second}"
+}
+
+setup_fixture() {
+  CASE_ROOT="${TEST_ROOT}/case"
+
+  rm -rf -- "${CASE_ROOT}"
+
+  PACKAGE_ROOT="${CASE_ROOT}/package"
+  TARGET_REAL="${CASE_ROOT}/target-real"
+  FAKE_PROC_ROOT="${CASE_ROOT}/proc"
+  MOCK_BIN="${CASE_ROOT}/mock-bin"
+  MOCK_SYNOPKG="${MOCK_BIN}/synopkg"
+  CHOWN_LOG="${CASE_ROOT}/chown.log"
+
+  mkdir -p \
+    "${PACKAGE_ROOT}/conf" \
+    "${PACKAGE_ROOT}/scripts" \
+    "${PACKAGE_ROOT}/var" \
+    "${TARGET_REAL}/bin" \
+    "${FAKE_PROC_ROOT}" \
+    "${MOCK_BIN}"
+
+  ln -s "${TARGET_REAL}" "${PACKAGE_ROOT}/target"
+
+  cp -- \
+    "${SAFE_SOURCE}" \
+    "${PACKAGE_ROOT}/conf/privilege.bootstrap-package"
+
+  cp -- \
+    "${ROOT_SOURCE}" \
+    "${PACKAGE_ROOT}/conf/privilege.bootstrap-root"
+
+  cp -- \
+    "${SAFE_SOURCE}" \
+    "${PACKAGE_ROOT}/conf/privilege"
+
+  cp -- \
+    "${BOOTSTRAP_SOURCE}" \
+    "${PACKAGE_ROOT}/scripts/tailscale-synology-bootstrap"
+
+  cat >"${TARGET_REAL}/bin/tailscaled" <<'TAILSCALED'
+#!/bin/sh
+exit 0
+TAILSCALED
+
+  chmod 0644 \
+    "${PACKAGE_ROOT}/conf/privilege" \
+    "${PACKAGE_ROOT}/conf/privilege.bootstrap-package" \
+    "${PACKAGE_ROOT}/conf/privilege.bootstrap-root"
+
+  chmod 0700 \
+    "${PACKAGE_ROOT}/scripts/tailscale-synology-bootstrap"
+
+  chmod 0755 \
+    "${TARGET_REAL}/bin/tailscaled"
+
+  : >"${CHOWN_LOG}"
+
+  cat >"${MOCK_SYNOPKG}" <<'SYNOPKG'
+#!/bin/sh
+
+set -eu
+
+action="${1:-}"
+
+case "${action}" in
+stop)
+    rm -f -- \
+        "${MOCK_PACKAGE_ROOT}/var/tailscaled.pid"
+
+    rm -rf -- \
+        "${MOCK_PROC_ROOT}/${MOCK_PID}"
+
+    exit 0
+    ;;
+start)
+    if [ "${MOCK_START_FAIL:-0}" = "1" ]; then
+        exit 1
+    fi
+
+    mkdir -p \
+        "${MOCK_PROC_ROOT}/${MOCK_PID}"
+
+    printf '%s\n' \
+        "${MOCK_PID}" \
+        >"${MOCK_PACKAGE_ROOT}/var/tailscaled.pid"
+
+    {
+        printf 'Name:\ttailscaled\n'
+        printf 'Uid:\t%s\t%s\t%s\t%s\n' \
+            "${MOCK_DAEMON_UID}" \
+            "${MOCK_DAEMON_UID}" \
+            "${MOCK_DAEMON_UID}" \
+            "${MOCK_DAEMON_UID}"
+    } >"${MOCK_PROC_ROOT}/${MOCK_PID}/status"
+
+    exit 0
+    ;;
+status)
+    if [ -d "${MOCK_PROC_ROOT}/${MOCK_PID}" ]; then
+        exit 0
+    fi
+
+    exit 3
+    ;;
+*)
+    exit 0
+    ;;
+
+esac
+SYNOPKG
+
+  chmod 0755 "${MOCK_SYNOPKG}"
+
+  MOCK_ID_UID=0
+  MOCK_STAT_UID=0
+  MOCK_DAEMON_UID=0
+  MOCK_START_FAIL=0
+  MOCK_PID=4242
+
+  export MOCK_PACKAGE_ROOT="${PACKAGE_ROOT}"
+  export MOCK_PROC_ROOT="${FAKE_PROC_ROOT}"
+  export MOCK_DAEMON_UID
+  export MOCK_START_FAIL
+  export MOCK_PID
+  export TAILSCALE_SYNOLOGY_PACKAGE_ROOT="${PACKAGE_ROOT}"
+  export TAILSCALE_SYNOLOGY_SYNOPKG="${MOCK_SYNOPKG}"
+  export TAILSCALE_SYNOLOGY_TEST_MODE=1
+  export TAILSCALE_SYNOLOGY_PROC_ROOT="${FAKE_PROC_ROOT}"
+}
+
+install_command_mocks() {
+  id() {
+    if [ "${1:-}" = "-u" ]; then
+      printf '%s\n' "${MOCK_ID_UID}"
+      return 0
+    fi
+
+    command id "$@"
+  }
+
+  stat() {
+    if [ "${1:-}" = "-c" ] &&
+      [ "${2:-}" = "%u" ]; then
+      printf '%s\n' "${MOCK_STAT_UID}"
+      return 0
+    fi
+
+    command stat "$@"
+  }
+
+  chown() {
+    printf '%s\n' "$*" >>"${CHOWN_LOG}"
+    return 0
+  }
+}
+
+load_bootstrap() {
+  # shellcheck disable=SC1090
+  source \
+    "${PACKAGE_ROOT}/scripts/tailscale-synology-bootstrap"
+
+  install_command_mocks
+}
+
+load_start_stop_definitions() {
+  local definitions="${CASE_ROOT}/start-stop-definitions.sh"
+
+  awk '
+        /^case \$1 in/ {
+            exit
+        }
+        {
+            print
+        }
+    ' "${START_STOP_SOURCE}" >"${definitions}"
+
+  export SYNOPKG_DSM_VERSION_MAJOR=7
+  export SYNOPKG_PKGVAR="${PACKAGE_ROOT}/var"
+  export SYNOPKG_PKGDEST="${PACKAGE_ROOT}/target"
+  export SYNOPKG_PKGNAME="Tailscale"
+  export TAILSCALE_SYNOLOGY_PACKAGE_ROOT="${PACKAGE_ROOT}"
+
+  # shellcheck disable=SC1090
+  source "${definitions}"
+}
+
+capture_main() {
+  set +e
+
+  CAPTURED_OUTPUT="$(
+    (
+      main "$@"
+    ) 2>&1
+  )"
+  CAPTURED_STATUS=$?
+
+  set -e
+}
+
+perform_successful_install() {
+  setup_fixture
+  load_bootstrap
+
+  MOCK_ID_UID=0
+  MOCK_DAEMON_UID=0
+  MOCK_START_FAIL=0
+
+  export MOCK_DAEMON_UID
+  export MOCK_START_FAIL
+
+  capture_main install
+
+  assert_status 0 "${CAPTURED_STATUS}"
+
+  assert_files_equal \
+    "${PACKAGE_ROOT}/conf/privilege" \
+    "${PACKAGE_ROOT}/conf/privilege.bootstrap-root"
+
+  if [ ! -f "${PACKAGE_ROOT}/var/root-bootstrap.state" ]; then
+    fail "bootstrap state was not created"
+  fi
+}
