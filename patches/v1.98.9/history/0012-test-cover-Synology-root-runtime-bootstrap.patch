+test_state_hashes() {
+  local state_binary_hash
+  local state_privilege_hash
+  local expected_binary_hash
+  local expected_privilege_hash
+
+  perform_successful_install
+
+  state_binary_hash="$(
+    awk -F= '
+            $1 == "tailscaled_sha256" {
+                print $2
+                exit
+            }
+        ' "${PACKAGE_ROOT}/var/root-bootstrap.state"
+  )"
+
+  state_privilege_hash="$(
+    awk -F= '
+            $1 == "privilege_sha256" {
+                print $2
+                exit
+            }
+        ' "${PACKAGE_ROOT}/var/root-bootstrap.state"
+  )"
+
+  expected_binary_hash="$(
+    sha256sum "${TARGET_REAL}/bin/tailscaled" |
+      awk '{print $1}'
+  )"
+
+  expected_privilege_hash="$(
+    sha256sum \
+      "${PACKAGE_ROOT}/conf/privilege.bootstrap-root" |
+      awk '{print $1}'
+  )"
+
+  if [ "${state_binary_hash}" != "${expected_binary_hash}" ]; then
+    fail "stored tailscaled hash is incorrect"
+  fi
+
+  if [ "${state_privilege_hash}" != "${expected_privilege_hash}" ]; then
+    fail "stored root privilege hash is incorrect"
+  fi
+}
