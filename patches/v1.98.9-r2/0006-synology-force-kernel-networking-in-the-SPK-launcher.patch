From 91f3ce6f846523f32a72d0e4463a4e55fb4c1cca Mon Sep 17 00:00:00 2001
From: a-t-eight <andreeww.trieu@gmail.com>
Date: Mon, 24 Aug 2026 18:23:03 +1000
Subject: [PATCH 06/58] synology: force kernel networking in the SPK launcher

Signed-off-by: a-t-eight <andreeww.trieu@gmail.com>
---
 release/dist/synology/files/scripts/start-stop-status | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/release/dist/synology/files/scripts/start-stop-status b/release/dist/synology/files/scripts/start-stop-status
index 8c6e5e216..64e911513 100755
--- a/release/dist/synology/files/scripts/start-stop-status
+++ b/release/dist/synology/files/scripts/start-stop-status
@@ -2,6 +2,13 @@
 
 SERVICE_NAME="tailscale"
 
+# DSM package services receive a restricted environment. Include the standard
+# system paths required for ip, iptables, ip6tables, nft, and related tools.
+export PATH="${SYNOPKG_PKGDEST}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
+
+# Route subnet traffic through the Linux kernel rather than netstack.
+export TS_DEBUG_NETSTACK_SUBNETS=false
+
 if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -eq "6" ]; then
     PKGVAR="/var/packages/Tailscale/etc"
 else
@@ -17,7 +24,8 @@ PORT="41641"
 SERVICE_COMMAND="${SYNOPKG_PKGDEST}/bin/tailscaled \
 --state=${STATE_FILE} \
 --socket=${SOCKET_FILE} \
---port=$PORT"
+--port=${PORT} \
+--tun=tailscale0"
 
 if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -eq "6" ]; then
     chown -R tailscale:tailscale "${PKGVAR}/"
