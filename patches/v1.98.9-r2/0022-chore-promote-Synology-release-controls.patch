+#!/usr/bin/env bash
+
+release_fail() {
+  printf 'FAIL: %s\n' "$1" >&2
+}
+
+release_pass() {
+  printf 'PASS: %s\n' "$1"
+}
+
+release_notice() {
+  printf 'NOTICE: %s\n' "$1"
+}
+
+release_clean_git() {
+  (
+    variable=""
+
+    while IFS= read -r variable; do
+      unset "$variable"
+    done < <(
+      git \
+        rev-parse \
+        --local-env-vars
+    )
+
+    command \
+      git \
+      "$@"
+  )
+}
+
+release_require_command() {
+  command_name="$1"
+
+  if command \
+    -v \
+    "$command_name" \
+    > /dev/null \
+    2>&1; then
+    return 0
+  fi
+
+  release_fail "required command is unavailable: ${command_name}"
+  return 1
+}
+
+release_require_worktree() {
+  worktree="$1"
+
+  if [ -d "$worktree/.git" ] ||
+    [ -f "$worktree/.git" ]; then
+    return 0
+  fi
+
+  release_fail "path is not a Git worktree: ${worktree}"
+  return 1
+}
+
+release_require_clean_worktree() {
+  worktree="$1"
+
+  status="$(
+    release_clean_git \
+      -C "$worktree" \
+      status \
+      --short \
+      --untracked-files=all
+  )"
+
+  if [ -z "$status" ]; then
+    return 0
+  fi
+
+  printf 'Observed status for %s:\n%s\n' \
+    "$worktree" \
+    "$status" \
+    >&2
+
+  release_fail "worktree is not clean: ${worktree}"
+  return 1
+}
