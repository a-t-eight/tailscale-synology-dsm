+diff --git a/release/dist/synology/files/scripts/start-stop-status b/release/dist/synology/files/scripts/start-stop-status
+index 769a378f6..a049217f1 100755
+--- a/release/dist/synology/files/scripts/start-stop-status
++++ b/release/dist/synology/files/scripts/start-stop-status
+@@ -9,6 +9,11 @@ export PATH="${SYNOPKG_PKGDEST}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/us
+ # Route subnet traffic through the Linux kernel rather than netstack.
+ export TS_DEBUG_NETSTACK_SUBNETS=false
+ 
++# DSM 7.3 on this package is validated against the legacy iptables backend.
++# Keep backend selection deterministic so the startup reconciler and the
++# Synology-specific daemon self-healing path operate on the same firewall.
++export TS_DEBUG_FIREWALL_MODE=iptables
++
+ if [ "${SYNOPKG_DSM_VERSION_MAJOR}" -eq "6" ]; then
+     PKGVAR="/var/packages/Tailscale/etc"
+ else
+@@ -29,6 +34,18 @@ STATE_FILE="${PKGVAR}/tailscaled.state"
+ SOCKET_FILE="${PKGVAR}/tailscaled.sock"
+ PORT="41641"
+ 
++TAILSCALE_BIN="${SYNOPKG_PKGDEST}/bin/tailscale"
++
++NETFILTER_LOCALAPI_ATTEMPTS="${TAILSCALE_SYNOLOGY_LOCALAPI_ATTEMPTS:-30}"
++
++NETFILTER_BACKEND_ATTEMPTS="${TAILSCALE_SYNOLOGY_BACKEND_ATTEMPTS:-45}"
++
++NETFILTER_REPAIR_ATTEMPTS="${TAILSCALE_SYNOLOGY_NETFILTER_REPAIR_ATTEMPTS:-15}"
++
++NETFILTER_SETTLE_SECONDS="${TAILSCALE_SYNOLOGY_NETFILTER_SETTLE_SECONDS:-8}"
++
++NETFILTER_POST_REPAIR_SETTLE_SECONDS="${TAILSCALE_SYNOLOGY_NETFILTER_POST_REPAIR_SETTLE_SECONDS:-3}"
++
+ SERVICE_COMMAND="${SYNOPKG_PKGDEST}/bin/tailscaled \
+ --state=${STATE_FILE} \
+ --socket=${SOCKET_FILE} \
+@@ -638,6 +655,338 @@ ensure_tun_created() {
+     fi
