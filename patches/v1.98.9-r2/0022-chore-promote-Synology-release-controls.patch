++    key="${table}|${chain}"
++
++    contains_line "${key}" "${CHAINS}" ||
++        iptables_error
++
++    remove_rule_prefix "${key}|"
++    ;;
++
++-X)
++    chain="${1:-}"
++    key="${table}|${chain}"
++
++    contains_line "${key}" "${CHAINS}" ||
++        iptables_error
++
++    if grep -Fq -- "${key}|" "${RULES}"; then
++        iptables_error
++    fi
++
++    remove_line "${key}" "${CHAINS}" ||
++        iptables_error
++    ;;
++
++*)
++    iptables_error
++    ;;
++esac
