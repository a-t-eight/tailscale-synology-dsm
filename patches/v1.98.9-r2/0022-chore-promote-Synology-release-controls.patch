++ensure_tun_created() {
++    local attempt=1
++    local tun_directory="${TUN_DEVICE%/*}"
++
++    case "${TUN_WAIT_ATTEMPTS}" in
++    ''|*[!0-9]*|0)
++        log_message ERROR \
++            "TAILSCALE_SYNOLOGY_TUN_WAIT_ATTEMPTS must be a positive integer"
++        return 1
++        ;;
++    esac
++
++    case "${TUN_WAIT_SECONDS}" in
++    ''|*[!0-9]*)
++        log_message ERROR \
++            "TAILSCALE_SYNOLOGY_TUN_WAIT_SECONDS must be a non-negative integer"
++        return 1
++        ;;
++    esac
++
++    while [ "${attempt}" -le "${TUN_WAIT_ATTEMPTS}" ]; do
++        if tun_device_is_ready; then
++            if ! chmod 0666 "${TUN_DEVICE}"; then
++                log_message ERROR \
++                    "cannot set permissions on ${TUN_DEVICE}"
++                return 1
++            fi
++
++            return 0
++        fi
++
++        if ! tun_driver_available; then
++            try_load_tun_driver ||
++                true
++        fi
++
++        if tun_driver_available; then
++            if ! mkdir -p -- "${tun_directory}"; then
++                log_message ERROR \
++                    "cannot create TUN device directory ${tun_directory}"
++                return 1
++            fi
++
++            if ! chmod 0755 "${tun_directory}"; then
++                log_message ERROR \
++                    "cannot set permissions on ${tun_directory}"
++                return 1
++            fi
++
++            if [ -e "${TUN_DEVICE}" ] ||
++                [ -L "${TUN_DEVICE}" ]
++            then
++                if ! rm -f -- "${TUN_DEVICE}"; then
++                    log_message ERROR \
++                        "cannot replace invalid TUN device path ${TUN_DEVICE}"
++                    return 1
++                fi
++            fi
++
++            mknod \
++                "${TUN_DEVICE}" \
++                c \
++                10 \
++                200 \
++                >/dev/null 2>&1 ||
++                true
++
++            if tun_device_is_ready; then
++                if ! chmod 0666 "${TUN_DEVICE}"; then
++                    log_message ERROR \
++                        "cannot set permissions on ${TUN_DEVICE}"
++                    return 1
++                fi
++
++                log_message INFO \
++                    "created kernel TUN device ${TUN_DEVICE}"
++
++                return 0
++            fi
++        fi
++
++        if [ "${attempt}" -lt "${TUN_WAIT_ATTEMPTS}" ]; then
++            sleep "${TUN_WAIT_SECONDS}"
++        fi
++
++        attempt=$((attempt + 1))
